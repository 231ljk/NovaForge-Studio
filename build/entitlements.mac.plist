<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- 不启用 App Sandbox：Electron 直接分发（非 App Store）模式下，
         沙箱会阻塞串口、shell 执行、autoUpdater 等核心功能。
         签名 + notarization + Hardened Runtime 已足够安全。 -->

    <!-- 必须联网：GitHub/Gitee OAuth、AI 云端 API、SMTP 发验证码 -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- 本地 llama-server（AI 推理）和局域网网关（18700 端口）需要监听 -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- ESP32 烧录的核心能力：串口访问（hardware/USB 串口） -->
    <key>com.apple.security.device.serial</key>
    <true/>

    <!-- 用户手动选择的文件读写：项目目录、.ino 文件、固件 bin -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- 下载目录读写：导出编译产物到默认位置 -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Hardened Runtime 强制声明：禁用 DYLD 注入、禁用 exec 指针 -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
