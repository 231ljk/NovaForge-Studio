.home {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
.hero { padding: 30rpx 28rpx; background: var(--card-bg); border-bottom: 1rpx solid var(--line-color); }
.hero-top { display: flex; align-items: center; justify-content: space-between; }
.hero-info { min-width: 0; }
.greeting { display: block; color: var(--text-muted); font-size: 23rpx; margin-bottom: 6rpx; }
.hero-title { display: block; color: var(--text-main); font-size: 36rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.add-button { flex-shrink: 0; width: 72rpx; height: 72rpx; margin-left: 20rpx; border-radius: 12rpx; background: #008a7f; display: flex; align-items: center; justify-content: center; }
.add-icon { color: #ffffff; font-size: 42rpx; line-height: 1; margin-top: -4rpx; }
.content { padding: 24rpx 28rpx 0; }
.demo-banner { background: #fff7e8; color: #ad4e00; border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 23rpx; margin-bottom: 20rpx; }
.overview { background: var(--card-bg); border: 1rpx solid var(--line-color); border-radius: 16rpx; padding: 26rpx; }
.overview-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }
.home-name { font-size: 28rpx; font-weight: 500; color: var(--text-main); }
.connection-text { color: var(--text-muted); font-size: 22rpx; }
.stats { display: flex; align-items: center; }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; }
.stat-item:not(:last-child)::after { content: ''; position: absolute; right: 0; top: 8rpx; bottom: 8rpx; width: 1rpx; background: var(--line-color); }
.stat-value { font-size: 34rpx; line-height: 1.3; font-weight: 600; color: var(--text-main); margin-bottom: 6rpx; }
.stat-label { font-size: 22rpx; color: var(--text-muted); }
.device-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.grid-item { width: 48.8%; min-height: 196rpx; margin-bottom: 16rpx; }
.grid-item-busy { opacity: 0.55; }
.device-card { width: 100%; min-height: 196rpx; padding: 22rpx; border: 1rpx solid var(--line-color); border-radius: 16rpx; background: var(--card-bg); display: flex; flex-direction: column; }
.device-on { background: rgba(0, 179, 164, 0.1); border-color: rgba(0, 138, 127, 0.45); }
.icon-wrap { width: 64rpx; height: 64rpx; border-radius: 12rpx; background: var(--field-bg); display: flex; align-items: center; justify-content: center; margin-bottom: 18rpx; }
.device-icon { font-size: 32rpx; line-height: 1; }
.device-name { font-size: 28rpx; font-weight: 500; color: var(--text-main); margin-bottom: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.device-state { font-size: 22rpx; color: var(--text-muted); }
.device-readonly .device-state { font-weight: 500; }
.empty-card { background: var(--card-bg); border: 1rpx solid var(--line-color); border-radius: 16rpx; padding: 42rpx 28rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.connect-empty { margin-top: 24rpx; padding-top: 64rpx; padding-bottom: 64rpx; }
.empty-title { color: var(--text-main); font-size: 28rpx; font-weight: 500; margin-bottom: 10rpx; }
.empty-text { color: var(--text-muted); font-size: 24rpx; line-height: 1.7; }
.connect-button { min-width: 200rpx; height: 76rpx; margin-top: 26rpx; padding: 0 24rpx; border-radius: 12rpx; background: #008a7f; color: #ffffff; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
@media (max-width: 340px) {
  .hero { padding-left: 20rpx; padding-right: 20rpx; }
  .content { padding-left: 20rpx; padding-right: 20rpx; }
  .hero-title { font-size: 32rpx; }
}
