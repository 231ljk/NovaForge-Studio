<view class="home {{themeClass}}">
  <view class="hero">
    <view class="hero-top">
      <view class="hero-info">
        <text class="greeting">{{greeting}}，{{displayName}}</text>
        <text class="hero-title">{{homeName}}</text>
      </view>
      <view class="add-button" wx:if="{{connected}}" bindtap="goAddDevice"><text class="add-icon">＋</text></view>
    </view>
  </view>

  <view class="content">
    <view class="demo-banner" wx:if="{{demo}}"><text>演示数据仅保存在本地</text></view>

    <block wx:if="{{connected}}">
      <view class="overview">
        <view class="overview-head">
          <text class="home-name">设备统计</text>
          <text class="connection-text">{{demo ? '演示家庭' : '已连接'}}</text>
        </view>
        <view class="stats">
          <view class="stat-item"><text class="stat-value">{{total}}</text><text class="stat-label">全部设备</text></view>
          <view class="stat-item"><text class="stat-value">{{active}}</text><text class="stat-label">正在运行</text></view>
          <view class="stat-item"><text class="stat-value">{{online}}</text><text class="stat-label">在线设备</text></view>
        </view>
      </view>

      <view class="section-head">
        <text class="section-title">我的设备</text>
        <text class="section-tip">{{refreshing ? '正在更新…' : '点按控制'}}</text>
      </view>

      <view class="device-grid" wx:if="{{entities.length > 0}}">
        <view class="grid-item {{busyId === item.id ? 'grid-item-busy' : ''}}" wx:for="{{entities}}" wx:key="id">
          <view class="device-card {{item.on ? 'device-on' : ''}} {{item.readonly ? 'device-readonly' : ''}}" data-id="{{item.id}}" bindtap="onTapDevice">
            <view class="icon-wrap"><text class="device-icon">{{item.icon}}</text></view>
            <text class="device-name">{{item.name}}</text>
            <text class="device-state">{{item.stateLabel}}</text>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:else>
        <text class="empty-title">{{refreshing ? '正在读取设备' : '还没有设备'}}</text>
        <text class="empty-text" wx:if="{{!refreshing}}">可点击右上角加号添加设备</text>
      </view>
    </block>

    <view class="empty-card connect-empty" wx:else>
      <text class="empty-title">尚未连接家庭</text>
      <text class="empty-text">在“我的”中填写 Home Assistant 地址</text>
      <view class="connect-button" bindtap="goMe"><text>去连接家庭</text></view>
    </view>
  </view>
</view>
