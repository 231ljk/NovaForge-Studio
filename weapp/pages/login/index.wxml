<view class="login {{themeClass}}">
  <text class="title">NovaForge</text>

  <view class="panel">
    <text class="label">Home Assistant 地址</text>
    <input class="ha-input" value="{{haUrl}}" placeholder="http://192.168.1.10:8123" bindinput="onHaUrlInput" />
    <text class="panel-tip">留空则自动连接这个微信已关联的家庭</text>
    <view class="agree-row">
      <checkbox-group bindchange="onAgreeChange">
        <label class="agree-label"><checkbox value="agree" checked="{{agreed}}" color="#008a7f" /></label>
      </checkbox-group>
      <view class="agree-text">已阅读并同意<text class="agree-link" data-doc="privacy" bindtap="onOpenDoc">《隐私政策》</text>与<text class="agree-link" data-doc="terms" bindtap="onOpenDoc">《用户协议》</text></view>
    </view>
    <view class="wx-button {{busy ? 'button-busy' : ''}}" bindtap="onWxTap">
      <text>{{busy ? '正在登录…' : '微信登录'}}</text>
    </view>
    <view class="privacy-line">
      <text>微信官方</text>
      <text class="privacy-link" bindtap="onOpenPrivacy">《隐私保护指引》</text>
    </view>
    <view class="status" wx:if="{{status}}"><text>{{status}}</text></view>

    <view class="retry-row" wx:if="{{errorCode}}">
      <view class="mini-button" bindtap="onRetry"><text>{{retryText || '重试'}}</text></view>
      <view class="mini-button mini-button-ghost" wx:if="{{needPrivacy}}" bindtap="onOpenPrivacy"><text>查看隐私指引</text></view>
    </view>

    <text class="cloud-hint" wx:if="{{cloudHint}}">{{cloudHint}}</text>

    <view class="homes" wx:if="{{homes.length}}">
      <text class="homes-title">已关联 {{homes.length}} 个家庭，点一下直接连</text>
      <view class="home-item" wx:for="{{homes}}" wx:key="haUrl" data-url="{{item.haUrl}}" bindtap="onHomeTap">
        <text class="home-name">{{item.haName || 'Home Assistant'}}</text>
        <text class="home-url">{{item.haUrl}}</text>
      </view>
    </view>
  </view>

  <view class="demo-link" bindtap="onDemoTap"><text>演示家庭</text></view>

  <view class="more">
    <view class="more-toggle" bindtap="onToggleGithub"><text>{{showGithub ? '收起' : '用 GitHub 账号登录'}}</text></view>

    <view class="more-body" wx:if="{{showGithub}}">
      <view class="github-button {{busy ? 'button-busy' : ''}}" bindtap="onGithubTap"><text>GitHub 登录</text></view>

      <view class="device-panel" wx:if="{{step === 'github'}}">
        <text class="device-title">GitHub 授权码</text>
        <text class="device-code">{{userCode}}</text>
        <view class="device-actions">
          <view class="mini-button" bindtap="onCopyCode"><text>复制验证码</text></view>
          <view class="mini-button mini-button-ghost" bindtap="onOpenVerify"><text>复制授权链接</text></view>
        </view>
        <text class="device-tip">在浏览器打开 github.com/login/device，输入验证码并授权，页面会自动继续。</text>
        <view class="link-button" bindtap="onCancelGithub"><text>取消</text></view>
      </view>
    </view>
  </view>

  <!-- 隐私政策 / 用户协议弹窗 -->
  <view class="doc-mask" wx:if="{{docVisible}}" bindtap="onCloseDoc">
    <view class="doc-card" catchtap="">
      <text class="doc-title">{{docTitle}}</text>
      <scroll-view class="doc-body" scroll-y><text>{{docText}}</text></scroll-view>
      <view class="doc-actions">
        <view class="mini-button" bindtap="onAcceptDoc"><text>同意并勾选</text></view>
        <view class="mini-button mini-button-ghost" bindtap="onCloseDoc"><text>关闭</text></view>
      </view>
    </view>
  </view>
</view>
