.add-device { min-height: 100vh; padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom)); background: var(--page-bg); }
.hero { margin-bottom: 24rpx; padding: 8rpx 4rpx 0; }
.hero-title { display: block; color: var(--text-main); font-size: 36rpx; font-weight: 600; margin-bottom: 6rpx; }
.hero-subtitle { color: var(--text-muted); font-size: 24rpx; }
.notice { margin-bottom: 20rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: #fff7e8; color: #ad4e00; font-size: 23rpx; }
.card { margin-bottom: 20rpx; padding: 26rpx; }
.scan-card { min-height: 180rpx; }
.scan-heading { display: flex; align-items: center; justify-content: space-between; }
.scan-heading-info { flex: 1; }
.card-title { display: block; color: var(--text-main); font-size: 29rpx; font-weight: 600; margin-bottom: 6rpx; }
.card-tip { display: block; color: var(--text-muted); font-size: 22rpx; margin-bottom: 22rpx; line-height: 1.6; }
.scanning-ring { width: 36rpx; height: 36rpx; border: 4rpx solid rgba(0, 179, 164, 0.16); border-top-color: #008a7f; border-radius: 50%; animation: scan-rotate 0.9s linear infinite; }
@keyframes scan-rotate { from { transform: rotate(0); } to { transform: rotate(360deg); } }
.device-list { margin-top: 8rpx; border-top: 1rpx solid var(--line-color); }
.scan-item { display: flex; align-items: center; padding: 22rpx 8rpx; border-bottom: 1rpx solid var(--line-color); }
.scan-item:last-child { border-bottom: none; }
.scan-item-active { background: rgba(0, 179, 164, 0.08); }
.scan-icon { flex-shrink: 0; width: 64rpx; height: 64rpx; border-radius: 12rpx; background: var(--field-bg); color: #008a7f; font-size: 28rpx; margin-right: 16rpx; display: flex; align-items: center; justify-content: center; }
.scan-info { flex: 1; min-width: 0; }
.scan-name { display: block; color: var(--text-main); font-size: 28rpx; font-weight: 500; margin-bottom: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scan-host { color: var(--text-muted); font-size: 22rpx; }
.scan-pick { flex-shrink: 0; margin-left: 12rpx; color: #008a7f; font-size: 23rpx; }
.scan-empty { margin-top: 20rpx; padding: 24rpx; border-radius: 12rpx; background: var(--field-bg); color: var(--text-muted); font-size: 24rpx; text-align: center; }
.retry-button { margin-top: 16rpx; color: #008a7f; font-size: 24rpx; }
.field-label { display: block; color: var(--text-secondary); font-size: 24rpx; margin-bottom: 10rpx; }
.field { width: 100%; height: 84rpx; padding: 0 20rpx; margin-bottom: 22rpx; border: 1rpx solid var(--line-color); border-radius: 12rpx; background: var(--field-bg); color: var(--text-main); font-size: 26rpx; }
.field-placeholder { color: var(--text-muted); }
.submit { height: 84rpx; margin-top: 8rpx; border-radius: 12rpx; background: #008a7f; color: #ffffff; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }
.button-disabled { opacity: 0.55; }
.cancel-button { margin-top: 20rpx; text-align: center; color: var(--text-muted); font-size: 24rpx; }
.status { padding: 18rpx 22rpx; border: 1rpx solid var(--line-color); border-radius: 12rpx; background: var(--card-bg); color: var(--text-secondary); font-size: 24rpx; line-height: 1.7; }
.connect-empty { padding-top: 48rpx; padding-bottom: 48rpx; }
@media (max-width: 340px) {
  .add-device { padding-left: 20rpx; padding-right: 20rpx; }
  .card { padding: 22rpx; }
  .hero-title { font-size: 34rpx; }
}
