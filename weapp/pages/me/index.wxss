.me {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: var(--page-bg);
}

.profile {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border: 1rpx solid var(--line-color);
  border-radius: 16rpx;
  background: var(--card-bg);
}

.avatar-wrap {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #008a7f;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text { color: #ffffff; font-size: 38rpx; font-weight: 500; }
.avatar-image { width: 96rpx; height: 96rpx; border-radius: 50%; display: block; }
.profile-info { flex: 1; min-width: 0; }
.profile-name {
  display: block;
  color: var(--text-main);
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile-sub {
  display: block;
  color: var(--text-muted);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.provider-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: var(--text-muted);
  font-size: 22rpx;
}

.stats-card {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 28rpx 0;
  border: 1rpx solid var(--line-color);
  border-radius: 16rpx;
  background: var(--card-bg);
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; }
.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 1rpx;
  background: var(--line-color);
}
.stat-value { color: var(--text-main); font-size: 34rpx; font-weight: 600; line-height: 1.3; margin-bottom: 6rpx; }
.stat-label { color: var(--text-muted); font-size: 22rpx; }

.group { margin-top: 28rpx; }
.group-title { display: block; padding: 0 4rpx; margin-bottom: 10rpx; color: var(--text-secondary); font-size: 24rpx; }
.group-card {
  border: 1rpx solid var(--line-color);
  border-radius: 16rpx;
  background: var(--card-bg);
  padding: 0 24rpx;
}
.row { min-height: 100rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line-color); }
.row:last-child { border-bottom: none; }
.row-main { flex: 1; min-width: 0; padding: 20rpx 16rpx 20rpx 0; }
.row-label { color: var(--text-main); font-size: 28rpx; }
.row-desc { display: block; color: var(--text-muted); font-size: 22rpx; line-height: 1.5; margin-top: 6rpx; word-break: break-all; }
.row-value-wrap { flex-shrink: 0; max-width: 45%; min-width: 0; display: flex; align-items: center; justify-content: flex-end; }
.row-value { color: var(--text-muted); font-size: 23rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; }
.row-arrow { margin-left: 8rpx; color: var(--text-muted); font-size: 30rpx; }

.connection-form { padding: 24rpx 0; border-bottom: 1rpx solid var(--line-color); }
.ha-input {
  height: 80rpx;
  margin-top: 20rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line-color);
  border-radius: 12rpx;
  background: var(--field-bg);
  color: var(--text-main);
  font-size: 25rpx;
}
.connect-button {
  height: 80rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #008a7f;
  color: #ffffff;
  font-size: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.connect-status { display: block; margin-top: 14rpx; color: var(--text-secondary); font-size: 23rpx; line-height: 1.6; }
.button-busy { opacity: 0.6; }

.appearance-card { padding-top: 24rpx; padding-bottom: 24rpx; }
.appearance-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.theme-options { display: flex; padding: 5rpx; border-radius: 12rpx; background: var(--field-bg); }
.theme-option { flex: 1; min-height: 64rpx; border-radius: 8rpx; color: var(--text-muted); font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.theme-option-active { background: var(--card-bg); color: #008a7f; font-weight: 500; }

.logout {
  margin-top: 40rpx;
  height: 88rpx;
  border: 1rpx solid var(--line-color);
  border-radius: 12rpx;
  background: var(--card-bg);
  color: #f53f3f;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

@media (max-width: 340px) {
  .me { padding-left: 20rpx; padding-right: 20rpx; }
  .profile { padding: 22rpx; }
  .avatar-wrap { width: 80rpx; height: 80rpx; margin-right: 16rpx; }
  .provider-tag { display: none; }
  .group-card { padding-left: 20rpx; padding-right: 20rpx; }
  .row-value-wrap { max-width: 38%; }
}
