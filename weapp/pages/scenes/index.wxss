.scenes { min-height: 100vh; padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background: var(--page-bg); }
.page-header { padding: 8rpx 4rpx 24rpx; }
.page-title { display: block; font-size: 36rpx; font-weight: 600; color: var(--text-main); }
.section-count { color: var(--text-muted); font-size: 22rpx; }
.scene-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.scene-item { width: 48.8%; margin-bottom: 16rpx; }
.scene-card { min-height: 166rpx; padding: 22rpx; border-radius: 16rpx; background: var(--card-bg); border: 1rpx solid var(--line-color); display: flex; flex-direction: column; }
.scene-card-busy { opacity: 0.55; }
.scene-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.scene-icon { width: 60rpx; height: 60rpx; border-radius: 12rpx; background: var(--field-bg); font-size: 32rpx; display: flex; align-items: center; justify-content: center; }
.scene-action { color: #008a7f; font-size: 23rpx; }
.scene-name { color: var(--text-main); font-size: 28rpx; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.automation-card { background: var(--card-bg); border: 1rpx solid var(--line-color); border-radius: 16rpx; padding: 0 24rpx; }
.automation-row { min-height: 104rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--line-color); }
.automation-row:last-child { border-bottom: none; }
.automation-info { flex: 1; min-width: 0; padding-right: 24rpx; }
.automation-name { display: block; color: var(--text-main); font-size: 28rpx; font-weight: 500; margin-bottom: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.automation-state { color: var(--text-muted); font-size: 22rpx; }
.automation-state-on { color: #008a7f; }
.empty-card { padding: 40rpx 28rpx; background: var(--card-bg); border: 1rpx solid var(--line-color); border-radius: 16rpx; text-align: center; color: var(--text-muted); font-size: 24rpx; line-height: 1.7; display: flex; flex-direction: column; align-items: center; }
.connect-empty { margin-top: 24rpx; padding-top: 64rpx; padding-bottom: 64rpx; }
.empty-title { color: var(--text-main); font-size: 28rpx; font-weight: 500; margin-bottom: 10rpx; }
.empty-text { color: var(--text-muted); font-size: 24rpx; }
.connect-button { min-width: 200rpx; height: 76rpx; margin-top: 26rpx; padding: 0 24rpx; border-radius: 12rpx; background: #008a7f; color: #ffffff; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
@media (max-width: 340px) {
  .scenes { padding-left: 20rpx; padding-right: 20rpx; }
}
