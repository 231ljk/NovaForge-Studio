<view class="scenes {{themeClass}}">
  <view class="page-header"><text class="page-title">场景</text></view>

  <view class="empty-card connect-empty" wx:if="{{!connected}}">
    <text class="empty-title">连接家庭后查看场景</text>
    <text class="empty-text">场景和自动化保存在 Home Assistant 中</text>
    <view class="connect-button" bindtap="goMe"><text>去连接家庭</text></view>
  </view>

  <block wx:else>
    <view class="section-head">
      <text class="section-title">我的场景</text>
      <text class="section-count">{{scenes.length}} 个</text>
    </view>
    <view class="scene-grid" wx:if="{{scenes.length > 0}}">
      <view class="scene-item" wx:for="{{scenes}}" wx:key="id">
        <view class="scene-card {{busyId === item.id ? 'scene-card-busy' : ''}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onRunScene">
          <view class="scene-top">
            <view class="scene-icon"><text>{{item.icon}}</text></view>
            <text class="scene-action">{{busyId === item.id ? '执行中' : '执行'}}</text>
          </view>
          <text class="scene-name">{{item.name}}</text>
        </view>
      </view>
    </view>
    <view class="empty-card" wx:else><text>{{refreshing ? '正在读取…' : '还没有场景'}}</text></view>

    <view class="section-head">
      <text class="section-title">自动化</text>
      <text class="section-count">{{activeAutomations}} 项运行中</text>
    </view>
    <view class="automation-card" wx:if="{{automations.length > 0}}">
      <view class="automation-row" wx:for="{{automations}}" wx:key="id">
        <view class="automation-info">
          <text class="automation-name">{{item.name}}</text>
          <text class="automation-state {{item.on ? 'automation-state-on' : ''}}">{{item.stateLabel}}</text>
        </view>
        <switch checked="{{item.on}}" color="#008a7f" disabled="{{!!busyId}}" data-id="{{item.id}}" bindchange="onToggleAutomation" />
      </view>
    </view>
    <view class="empty-card" wx:else><text>{{refreshing ? '正在读取…' : '还没有自动化'}}</text></view>
  </block>
</view>
