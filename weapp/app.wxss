page {
  --page-bg: #f5f6f7;
  --card-bg: #ffffff;
  --text-main: #1d2129;
  --text-secondary: #4e5969;
  --text-muted: #86909c;
  --line-color: #f2f3f5;
  --field-bg: #f5f6f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC',
    'Hiragino Sans GB', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-main);
  background-color: var(--page-bg);
}

.theme-dark {
  --page-bg: #101214;
  --card-bg: #1d2022;
  --text-main: #edf0f2;
  --text-secondary: #c2c8cd;
  --text-muted: #8f979f;
  --line-color: #303438;
  --field-bg: #272b2e;
  color: var(--text-main);
  background: var(--page-bg);
}

view,
text,
input,
textarea,
scroll-view,
image {
  box-sizing: border-box;
}

.card {
  background: var(--card-bg);
  border: 1rpx solid var(--line-color);
  border-radius: 16rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 16rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.section-tip {
  font-size: 22rpx;
  color: var(--text-muted);
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
